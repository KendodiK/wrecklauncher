<Page x:Class="wreckchat.Presentation.ChatPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:wreckchat.Presentation"
      xmlns:utu="using:Uno.Toolkit.UI"
      NavigationCacheMode="Required"
      Background="#0F172A">
  <Grid Background="#0F172A">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header with Search -->
    <Border Grid.Row="0"
            Background="#1E293B"
            BorderBrush="#334155"
            BorderThickness="0,0,0,1"
            Padding="16">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Messages"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="#E2E8F0"
                   VerticalAlignment="Center"/>

        <Button Grid.Column="1"
                Content="✎"
                Background="#10B981"
                Foreground="#FFFFFF"
                Width="44"
                Height="44"
                CornerRadius="22"
                FontSize="20"/>
      </Grid>
    </Border>

    <!-- Chat List -->
    <ListView Grid.Row="1"
              ItemsSource="{Binding Chats}"
              Background="#0F172A"
              SelectionMode="Single">
      <ListView.ItemTemplate>
        <DataTemplate>
          <Border Padding="12" 
                  BorderBrush="#334155" 
                  BorderThickness="0,0,0,1"
                  Background="#0F172A">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <!-- Avatar -->
              <Ellipse Grid.Column="0"
                       Width="48"
                       Height="48"
                       Fill="#334155"
                       Margin="0,0,12,0"/>

              <!-- Chat Info -->
              <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#E2E8F0"/>
                <TextBlock Text="{Binding LastMessage}"
                           FontSize="12"
                           Foreground="#94A3B8"
                           TextTrimming="CharacterEllipsis"/>
              </StackPanel>

              <!-- Time -->
              <StackPanel Grid.Column="2" 
                          Spacing="4"
                          VerticalAlignment="Top"
                          Margin="12,0,0,0">
                <TextBlock Text="{Binding Time}"
                           FontSize="11"
                           Foreground="#64748B"
                           TextAlignment="Right"/>
                <Border Background="#10B981"
                        Width="20"
                        Height="20"
                        CornerRadius="10"
                        Padding="0">
                  <TextBlock Text="{Binding UnreadCount}"
                             FontSize="10"
                             Foreground="#FFFFFF"
                             TextAlignment="Center"
                             VerticalAlignment="Center"/>
                </Border>
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>

    <!-- Bottom Navigation -->
    <Border Grid.Row="2"
            Background="#1E293B"
            BorderBrush="#334155"
            BorderThickness="0,1,0,0"
            Padding="0">
      <Grid Height="70" Padding="0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Messages Tab (Active) -->
        <Button Grid.Column="0"
                Content="💬"
                Background="Transparent"
                Foreground="#10B981"
                FontSize="24"
                Padding="0"/>

        <!-- Notifications Tab -->
        <Button Grid.Column="1"
                Content="🔔"
                Background="Transparent"
                Foreground="#94A3B8"
                FontSize="24"
                Padding="0"/>

        <!-- Friends Tab -->
        <Button Grid.Column="2"
                Content="👥"
                Background="Transparent"
                Foreground="#94A3B8"
                FontSize="24"
                Padding="0"/>

        <!-- Profile Tab -->
        <Button Grid.Column="3"
                Content="👤"
                Background="Transparent"
                Foreground="#94A3B8"
                FontSize="24"
                Padding="0"/>
      </Grid>
    </Border>
  </Grid>
</Page>
