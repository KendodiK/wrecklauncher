<Page x:Class="wreckchat.Presentation.FriendsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:wreckchat.Presentation"
      NavigationCacheMode="Required"
      Background="#0F172A">
  <Grid Background="#0F172A">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header with Add Friend Button -->
    <Border Grid.Row="0"
            Background="#1E293B"
            BorderBrush="#334155"
            BorderThickness="0,0,0,1"
            Padding="16">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Friends"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="#E2E8F0"
                   VerticalAlignment="Center"/>

        <Button Grid.Column="1"
                Content="➕"
                Background="#10B981"
                Foreground="#FFFFFF"
                Width="44"
                Height="44"
                CornerRadius="22"
                FontSize="20"/>
      </Grid>
    </Border>

    <!-- Friends List with Search -->
    <Grid Grid.Row="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Search Bar -->
      <Border Grid.Row="0"
              Background="#1E293B"
              Padding="16"
              BorderBrush="#334155"
              BorderThickness="0,0,0,1">
        <TextBox PlaceholderText="Search friends..."
                 Background="#334155"
                 Foreground="#E2E8F0"
                 BorderBrush="#475569"
                 Padding="12"
                 CornerRadius="8"
                 Height="40"/>
      </Border>

      <!-- Friends ListView -->
      <ListView Grid.Row="1"
                ItemsSource="{Binding Friends}"
                Background="#0F172A"
                SelectionMode="Single">
        <ListView.ItemTemplate>
          <DataTemplate>
            <Border Padding="16" 
                    BorderBrush="#334155" 
                    BorderThickness="0,0,0,1"
                    Background="#0F172A">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="56"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Avatar -->
                <Ellipse Grid.Column="0"
                         Width="48"
                         Height="48"
                         Fill="#334155"
                         Margin="0,0,12,0"/>

                <!-- Friend Info -->
                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}"
                             FontSize="14"
                             FontWeight="SemiBold"
                             Foreground="#E2E8F0"/>
                  <TextBlock Text="{Binding Status}"
                             FontSize="12"
                             Foreground="#94A3B8"/>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="2" 
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0">
                  <Button Content="💬"
                          Background="#334155"
                          Foreground="#E2E8F0"
                          Width="36"
                          Height="36"
                          CornerRadius="8"
                          FontSize="16"/>
                  <Button Content="⋯"
                          Background="Transparent"
                          Foreground="#94A3B8"
                          Width="36"
                          Height="36"
                          Padding="0"
                          FontSize="18"/>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
    </Grid>

    <!-- Bottom Navigation -->
    <Border Grid.Row="2"
            Background="#1E293B"
            BorderBrush="#334155"
            BorderThickness="0,1,0,0"
            Padding="0">
      <Grid Height="70" Padding="0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Messages Tab -->
        <Button Grid.Column="0"
                Content="💬"
                Background="Transparent"
                Foreground="#94A3B8"
                FontSize="24"
                Padding="0"/>

        <!-- Notifications Tab -->
        <Button Grid.Column="1"
                Content="🔔"
                Background="Transparent"
                Foreground="#94A3B8"
                FontSize="24"
                Padding="0"/>

        <!-- Friends Tab (Active) -->
        <Button Grid.Column="2"
                Content="👥"
                Background="Transparent"
                Foreground="#10B981"
                FontSize="24"
                Padding="0"/>

        <!-- Profile Tab -->
        <Button Grid.Column="3"
                Content="👤"
                Background="Transparent"
                Foreground="#94A3B8"
                FontSize="24"
                Padding="0"/>
      </Grid>
    </Border>
  </Grid>
</Page>
