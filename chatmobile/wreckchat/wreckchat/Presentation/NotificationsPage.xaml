<Page x:Class="wreckchat.Presentation.NotificationsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:wreckchat.Presentation"
      NavigationCacheMode="Required"
      Background="#0F172A">
  <Grid Background="#0F172A">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <Border Grid.Row="0"
            Background="#1E293B"
            BorderBrush="#334155"
            BorderThickness="0,0,0,1"
            Padding="16">
      <TextBlock Text="Notifications"
                 FontSize="24"
                 FontWeight="Bold"
                 Foreground="#E2E8F0"/>
    </Border>

    <!-- Notifications List -->
    <ListView Grid.Row="1"
              ItemsSource="{Binding Notifications}"
              Background="#0F172A"
              SelectionMode="Single">
      <ListView.ItemTemplate>
        <DataTemplate>
          <Border Padding="16" 
                  BorderBrush="#334155" 
                  BorderThickness="0,0,0,1"
                  Background="#0F172A">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <!-- Notification Icon -->
              <Border Grid.Column="0"
                      Width="48"
                      Height="48"
                      CornerRadius="24"
                      Background="#334155"
                      Margin="0,0,12,0"
                      Padding="0">
                <TextBlock Text="{Binding Icon}"
                           FontSize="24"
                           TextAlignment="Center"
                           VerticalAlignment="Center"/>
              </Border>

              <!-- Notification Content -->
              <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#E2E8F0"/>
                <TextBlock Text="{Binding Message}"
                           FontSize="12"
                           Foreground="#94A3B8"
                           TextWrapping="Wrap"/>
              </StackPanel>

              <!-- Time and Action -->
              <StackPanel Grid.Column="2" 
                          Spacing="8"
                          VerticalAlignment="Center"
                          Margin="12,0,0,0">
                <TextBlock Text="{Binding Time}"
                           FontSize="11"
                           Foreground="#64748B"
                           TextAlignment="Right"/>
                <Button Content="✓"
                        Background="#10B981"
                        Foreground="#FFFFFF"
                        Width="32"
                        Height="32"
                        CornerRadius="16"
                        FontSize="16"/>
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>

    <!-- Bottom Navigation -->
    <Border Grid.Row="2"
            Background="#1E293B"
            BorderBrush="#334155"
            BorderThickness="0,1,0,0"
            Padding="0">
      <Grid Height="70" Padding="0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Messages Tab -->
        <Button Grid.Column="0"
                Content="💬"
                Background="Transparent"
                Foreground="#94A3B8"
                FontSize="24"
                Padding="0"/>

        <!-- Notifications Tab (Active) -->
        <Button Grid.Column="1"
                Content="🔔"
                Background="Transparent"
                Foreground="#10B981"
                FontSize="24"
                Padding="0"/>

        <!-- Friends Tab -->
        <Button Grid.Column="2"
                Content="👥"
                Background="Transparent"
                Foreground="#94A3B8"
                FontSize="24"
                Padding="0"/>

        <!-- Profile Tab -->
        <Button Grid.Column="3"
                Content="👤"
                Background="Transparent"
                Foreground="#94A3B8"
                FontSize="24"
                Padding="0"/>
      </Grid>
    </Border>
  </Grid>
</Page>
