<Page x:Class="wreckchat.Presentation.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:wreckchat.Presentation"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:um="using:Uno.Material"
      NavigationCacheMode="Required"
      Background="#0F172A">
  <ScrollViewer IsTabStop="True">
    <Grid utu:SafeArea.Insets="VisibleBounds" 
          Background="#0F172A" 
          Padding="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Login Form Container -->
      <StackPanel Grid.Row="0"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Stretch"
                  Padding="24"
                  Spacing="24">

        <!-- Title -->
        <TextBlock Text="WreckChat"
                   FontSize="48"
                   FontWeight="Bold"
                   Foreground="#E2E8F0"
                   TextAlignment="Center"
                   Margin="0,0,0,16"/>

        <TextBlock Text="Welcome Back"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Foreground="#CBD5E1"
                   TextAlignment="Center"
                   Margin="0,0,0,8"/>

        <!-- Username Input -->
        <TextBlock Text="Username"
                   FontSize="14"
                   Foreground="#94A3B8"
                   Margin="0,0,0,8"/>
        <TextBox x:Name="UsernameInput"
                 PlaceholderText="Enter your username"
                 Background="#1E293B"
                 Foreground="#E2E8F0"
                 BorderBrush="#334155"
                 BorderThickness="1"
                 Padding="12"
                 CornerRadius="8"
                 Height="44"/>

        <!-- Password Input -->
        <TextBlock Text="Password"
                   FontSize="14"
                   Foreground="#94A3B8"
                   Margin="0,16,0,8"/>
        <PasswordBox x:Name="PasswordInput"
                     Background="#1E293B"
                     Foreground="#E2E8F0"
                     BorderBrush="#334155"
                     BorderThickness="1"
                     Padding="12"
                     CornerRadius="8"
                     Height="44"/>

        <!-- Remember Me & Forgot Password -->
        <Grid Margin="0,8,0,16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <CheckBox Background="Transparent"/>
            <TextBlock Text="Remember me"
                       FontSize="12"
                       Foreground="#94A3B8"
                       VerticalAlignment="Center"/>
          </StackPanel>

          <Button Grid.Column="1"
                  Content="Forgot password?"
                  Background="Transparent"
                  Foreground="#34D399"
                  Padding="0"
                  FontSize="12"/>
        </Grid>

        <!-- Login Button -->
        <Button Content="Login"
                Background="#10B981"
                Foreground="#FFFFFF"
                Height="44"
                CornerRadius="8"
                FontSize="16"
                FontWeight="SemiBold"/>

        <!-- Or Divider -->
        <Grid Margin="0,8,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" 
                  BorderBrush="#334155" 
                  BorderThickness="0,1,0,0" 
                  VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" 
                     Text="OR" 
                     Foreground="#64748B" 
                     Padding="16,0" 
                     FontSize="12"/>
          <Border Grid.Column="2" 
                  BorderBrush="#334155" 
                  BorderThickness="0,1,0,0" 
                  VerticalAlignment="Center"/>
        </Grid>

        <!-- Social Logins -->
        <StackPanel Spacing="12">
          <Button Content="🔵 Continue with Google"
                  Background="#334155"
                  Foreground="#E2E8F0"
                  Height="44"
                  CornerRadius="8"
                  FontSize="14"/>
          <Button Content="🤖 Continue with GitHub"
                  Background="#334155"
                  Foreground="#E2E8F0"
                  Height="44"
                  CornerRadius="8"
                  FontSize="14"/>
        </StackPanel>

        <!-- Sign Up Link -->
        <StackPanel Orientation="Horizontal" 
                    HorizontalAlignment="Center" 
                    Spacing="4">
          <TextBlock Text="Don't have an account?"
                     FontSize="12"
                     Foreground="#94A3B8"/>
          <Button Content="Sign up"
                  Background="Transparent"
                  Foreground="#34D399"
                  Padding="0"
                  FontSize="12"/>
        </StackPanel>
      </StackPanel>

      <!-- Footer -->
      <Border Grid.Row="1"
              BorderBrush="#334155"
              BorderThickness="0,1,0,0"
              Background="#0F172A"
              Padding="24,16">
        <TextBlock Text="© 2024 WreckChat. All rights reserved."
                   FontSize="11"
                   Foreground="#64748B"
                   TextAlignment="Center"/>
      </Border>
    </Grid>
  </ScrollViewer>
</Page>
