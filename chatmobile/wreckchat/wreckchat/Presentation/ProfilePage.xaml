<Page x:Class="wreckchat.Presentation.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:wreckchat.Presentation"
      NavigationCacheMode="Required"
      Background="#0F172A">
  <Grid Background="#0F172A">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <Border Grid.Row="0"
            Background="#1E293B"
            BorderBrush="#334155"
            BorderThickness="0,0,0,1"
            Padding="16">
      <TextBlock Text="Profile"
                 FontSize="24"
                 FontWeight="Bold"
                 Foreground="#E2E8F0"/>
    </Border>

    <!-- Profile Content -->
    <ScrollViewer Grid.Row="1" Background="#0F172A">
      <StackPanel Padding="16" Spacing="24">

        <!-- Profile Header Section -->
        <Border Background="#1E293B"
                BorderBrush="#334155"
                BorderThickness="1"
                CornerRadius="12"
                Padding="20">
          <StackPanel Spacing="16" HorizontalAlignment="Center">

            <!-- Avatar -->
            <Ellipse Width="96"
                     Height="96"
                     Fill="#334155"
                     HorizontalAlignment="Center"/>

            <!-- User Info -->
            <StackPanel Spacing="8" HorizontalAlignment="Center">
              <TextBlock Text="{Binding Username}"
                         FontSize="20"
                         FontWeight="SemiBold"
                         Foreground="#E2E8F0"
                         TextAlignment="Center"/>
              <TextBlock Text="{Binding UserStatus}"
                         FontSize="12"
                         Foreground="#94A3B8"
                         TextAlignment="Center"/>
            </StackPanel>

            <!-- Action Buttons -->
            <StackPanel Orientation="Horizontal" 
                        Spacing="8"
                        HorizontalAlignment="Center">
              <Button Content="📝 Edit Profile"
                      Background="#10B981"
                      Foreground="#FFFFFF"
                      Padding="12,8"
                      CornerRadius="8"
                      FontSize="12"/>
              <Button Content="📷 Change Avatar"
                      Background="#334155"
                      Foreground="#E2E8F0"
                      Padding="12,8"
                      CornerRadius="8"
                      FontSize="12"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Stats Section -->
        <Border Background="#1E293B"
                BorderBrush="#334155"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Friends Count -->
            <StackPanel Grid.Column="0" Spacing="8" HorizontalAlignment="Center">
              <TextBlock Text="{Binding FriendsCount}"
                         FontSize="18"
                         FontWeight="Bold"
                         Foreground="#E2E8F0"
                         TextAlignment="Center"/>
              <TextBlock Text="Friends"
                         FontSize="11"
                         Foreground="#94A3B8"
                         TextAlignment="Center"/>
            </StackPanel>

            <!-- Messages Count -->
            <StackPanel Grid.Column="1" Spacing="8" HorizontalAlignment="Center">
              <TextBlock Text="{Binding MessagesCount}"
                         FontSize="18"
                         FontWeight="Bold"
                         Foreground="#E2E8F0"
                         TextAlignment="Center"/>
              <TextBlock Text="Messages"
                         FontSize="11"
                         Foreground="#94A3B8"
                         TextAlignment="Center"/>
            </StackPanel>

            <!-- Joined Date -->
            <StackPanel Grid.Column="2" Spacing="8" HorizontalAlignment="Center">
              <TextBlock Text="{Binding JoinedMonth}"
                         FontSize="18"
                         FontWeight="Bold"
                         Foreground="#E2E8F0"
                         TextAlignment="Center"/>
              <TextBlock Text="Joined"
                         FontSize="11"
                         Foreground="#94A3B8"
                         TextAlignment="Center"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Bio Section -->
        <Border Background="#1E293B"
                BorderBrush="#334155"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16">
          <StackPanel Spacing="8">
            <TextBlock Text="About"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#CBD5E1"/>
            <TextBlock Text="{Binding Bio}"
                       FontSize="13"
                       Foreground="#94A3B8"
                       TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <!-- Settings Section -->
        <Border Background="#1E293B"
                BorderBrush="#334155"
                BorderThickness="1"
                CornerRadius="12"
                Padding="0">
          <StackPanel>
            <Button Content="⚙️ Settings"
                    Background="Transparent"
                    Foreground="#E2E8F0"
                    HorizontalContentAlignment="Left"
                    Padding="16"
                    BorderThickness="0"/>
            <Border BorderBrush="#334155" BorderThickness="0,1,0,0"/>
            <Button Content="🔒 Privacy"
                    Background="Transparent"
                    Foreground="#E2E8F0"
                    HorizontalContentAlignment="Left"
                    Padding="16"
                    BorderThickness="0"/>
            <Border BorderBrush="#334155" BorderThickness="0,1,0,0"/>
            <Button Content="❓ Help &amp; Support"
                    Background="Transparent"
                    Foreground="#E2E8F0"
                    HorizontalContentAlignment="Left"
                    Padding="16"
                    BorderThickness="0"/>
          </StackPanel>
        </Border>

        <!-- Logout Button -->
        <Button Content="🚪 Logout"
                Background="#DC2626"
                Foreground="#FFFFFF"
                Height="44"
                CornerRadius="8"
                FontSize="14"
                FontWeight="SemiBold"/>
      </StackPanel>
    </ScrollViewer>

    <!-- Bottom Navigation -->
    <Border Grid.Row="2"
            Background="#1E293B"
            BorderBrush="#334155"
            BorderThickness="0,1,0,0"
            Padding="0">
      <Grid Height="70" Padding="0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Messages Tab -->
        <Button Grid.Column="0"
                Content="💬"
                Background="Transparent"
                Foreground="#94A3B8"
                FontSize="24"
                Padding="0"/>

        <!-- Notifications Tab -->
        <Button Grid.Column="1"
                Content="🔔"
                Background="Transparent"
                Foreground="#94A3B8"
                FontSize="24"
                Padding="0"/>

        <!-- Friends Tab -->
        <Button Grid.Column="2"
                Content="👥"
                Background="Transparent"
                Foreground="#94A3B8"
                FontSize="24"
                Padding="0"/>

        <!-- Profile Tab (Active) -->
        <Button Grid.Column="3"
                Content="👤"
                Background="Transparent"
                Foreground="#10B981"
                FontSize="24"
                Padding="0"/>
      </Grid>
    </Border>
  </Grid>
</Page>
