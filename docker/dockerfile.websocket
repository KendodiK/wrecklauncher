FROM node:20-bullseye-slim

WORKDIR /app

# Skip heavyweight browser/electron binary downloads for websocket-only runtime.
ENV PUPPETEER_SKIP_DOWNLOAD=true
ENV ELECTRON_SKIP_BINARY_DOWNLOAD=1

RUN chown -R node:node /app

COPY --chown=node:node websocket/package*.json ./

USER node

# Use lockfile when present; otherwise fall back to npm install.
RUN if [ -f package-lock.json ]; then \
      npm ci --no-audit --no-fund; \
    else \
      npm install --no-audit --no-fund; \
    fi

COPY --chown=node:node websocket ./websocket/
COPY --chown=node:node database ./database/

EXPOSE 8080

CMD ["node", "websocket/ws.cjs"]
