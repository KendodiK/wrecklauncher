{
  "name": "frontendv3",
  "version": "1.0.0",
  "description": "Electron + React + Tailwind frontend",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently -k -n VITE,ELECTRON -c green,blue \"vite\" \"cross-env NODE_ENV=development OPEN_DEVTOOLS=1 electron .\"",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "cross-env NODE_ENV=development electron .",
    "electron:dev:only": "cross-env NODE_ENV=development electron .",
    "electron": "cross-env NODE_ENV=production electron .",
    "start": "npm run electron",
    "electron:dev:3000": "cross-env NODE_ENV=development WRECK_BACKEND_URL=http://127.0.0.1:3000 electron .",
    "electron:dev:3000:insecure": "cross-env NODE_ENV=development WRECK_BACKEND_URL=http://127.0.0.1:3000 electron ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^7.3.1",
    "wait-on": "^8.0.5"
  },
  "dependencies": {
    "cloudscraper": "^4.6.0",
    "electron": "^32.2.3",
    "motion": "^12.31.0",
    "puppeteer": "^24.38.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.13.0",
    "webtorrent": "^2.8.5"
  }
}
