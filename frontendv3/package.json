{
  "name": "anchor-launcher",
  "version": "1.0.0",
  "description": "Electron + React + Tailwind frontend",
  "productName": "Anchor Launcher",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "cross-env OPEN_DEVTOOLS=1 node scripts/electron-dev.cjs",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "cross-env NODE_ENV=development electron .",
    "electron:dev:only": "cross-env NODE_ENV=development electron .",
    "electron": "cross-env NODE_ENV=production electron .",
    "start": "electron-forge start",
    "electron:dev:3000": "cross-env NODE_ENV=development WRECK_BACKEND_URL=http://127.0.0.1:3000 electron .",
    "electron:dev:3000:insecure": "cross-env NODE_ENV=development WRECK_BACKEND_URL=http://127.0.0.1:3000 electron .",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "dist": "npm run build && electron-builder",
    "dist:nsis": "npm run build && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.AnchorLauncher.app",
    "productName": "Anchor Launcher",
    "artifactName": "Anchor-Launcher-Setup-Win.exe",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      "logo_fixed.ico"
    ],
    "win": {
      "target": "nsis",
      "icon": "logo_fixed.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "installerIcon": "logo_fixed.ico",
      "uninstallerIcon": "logo_fixed.ico",
      "installerHeaderIcon": "logo_fixed.ico",
      "createDesktopShortcut": "always",
      "allowToChangeInstallationDirectory": true
    }
  },
  "keywords": [],
  "author": "AnchorLauncher Team",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^32.3.3",
    "electron-builder": "^26.8.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^7.3.1",
    "wait-on": "^8.0.5"
  },
  "dependencies": {
    "cloudscraper": "^4.6.0",
    "electron-squirrel-startup": "^1.0.1",
    "motion": "^12.31.0",
    "puppeteer": "^24.38.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.13.0",
    "request": "^2.88.2",
    "vdf": "^0.0.2",
    "webtorrent": "^2.8.5",
    "winreg": "^1.2.5"
  }
}